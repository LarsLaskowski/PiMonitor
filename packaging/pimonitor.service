[Unit]
Description=PiMonitor system monitoring dashboard
Documentation=https://github.com/larslaskowski/pimonitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pimonitor
Group=pimonitor
# vcgencmd (GPU/PMIC temperature, under-voltage/throttling state) talks to
# the firmware through a device node that Raspberry Pi OS's udev rules
# create as root:video, mode 0660: /dev/vcio_gencmd on current releases
# (e.g. Pi 5), /dev/vchiq on older ones. Without this group vcgencmd exits
# with status 255 ("Can't open device file: /dev/vcio_gencmd" or "VCHI
# initialization failed"). Set here rather than via
# usermod in install.sh so manual installs of this unit get it as well.
# The video group is a static base-passwd group on every Debian-family
# system, so this does not fail on non-Pi hosts.
SupplementaryGroups=video
ExecStart=/usr/local/bin/pimonitor -config /etc/pimonitor/config.yaml
Restart=on-failure
RestartSec=5

# The REST API key can be set as api_key in the config file above, or kept
# out of it entirely by uncommenting the line below and putting
# PIMONITOR_API_KEY=<secret> into a root-only file (chown root:root, chmod
# 600 - systemd reads it as PID 1, before dropping to the pimonitor user).
# Never pass the key via the -api-key flag here: the command line of a
# running process is world-readable through /proc/<pid>/cmdline.
#EnvironmentFile=/etc/pimonitor/pimonitor.env

# Hardening. PiMonitor only ever reads world-readable files under /proc,
# /sys/class/thermal, /sys/devices/system/cpu/*/cpufreq, /sys/class/hwmon,
# /etc/os-release, and the apt cache under
# /var/lib/apt/lists/ (via `apt list --upgradable`), plus binds a TCP
# listener - it needs no elevated privileges. The one exception is the
# video group (SupplementaryGroups= above) for vcgencmd's device access.
# Its only filesystem write access is the state directory below, where it
# persists metric history across restarts (data_dir in config.yaml,
# default /var/lib/pimonitor).
NoNewPrivileges=true
ProtectSystem=strict
# Creates /var/lib/pimonitor owned by the service user and, together with
# ReadWritePaths, keeps it writable despite ProtectSystem=strict.
StateDirectory=pimonitor
ReadWritePaths=/var/lib/pimonitor
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

# Additional sandboxing (defense in depth). These directives further reduce
# the kernel attack surface exposed to a process that parses network-facing
# input and shells out to `apt`/`vcgencmd`. They are cheap and widely
# supported on Debian-family systems.
#
# NOTE: PrivateDevices is deliberately NOT set - `vcgencmd` needs
# /dev/vcio_gencmd or /dev/vchiq (see SupplementaryGroups=video above) to read
# the GPU/PMIC temperature and the throttled state. Enabling it would
# require paired DeviceAllow= rules and is out of scope. For the same
# reason ProtectClock is NOT set: it implies DeviceAllow=char-rtc, and any
# DeviceAllow= flips DevicePolicy into enforcing mode, which would silently
# block those devices. CAP_SYS_TIME is already dropped (empty
# CapabilityBoundingSet) and @clock syscalls are already denied by
# ~@privileged below, so ProtectClock would add almost nothing anyway.
#
# MemoryDenyWriteExecute is safe here: the binary is pure Go with CGO
# disabled (no JIT, no W+X pages).
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectHostname=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Return EPERM for filtered syscalls instead of killing the process with
# SIGSYS. Go's runtime raises RLIMIT_NOFILE via setrlimit/prlimit64 at
# startup (both in @resources), and the apt/vcgencmd children inherit this
# filter; a soft EPERM lets them all degrade gracefully rather than crash.
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
